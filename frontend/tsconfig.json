{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",

    "rootDir": "./src",
    "outDir": "./build",

    "strict": true,
    "skipLibCheck": true,

    "types": [],

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ]
}